FROM node:24-bookworm

WORKDIR /app

RUN corepack enable

# Copy dependency files
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install

# Copy application source
COPY . .

ENV NODE_ENV=development
ENV WATCHPACK_POLLING=true
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["yarn", "dev"]